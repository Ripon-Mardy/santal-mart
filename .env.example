# ─────────────────────────────────────────────────────────────
# BazarX — environment configuration
# Copy this file to .env (and .env.local for secrets you don't
# want to share) and fill in real values for your environment.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# --- App -------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BazarX

# --- Database (PostgreSQL) --------------------------------------
# Matches docker-compose.yml's "postgres" service by default.
DATABASE_URL="postgresql://bazarx:bazarx@localhost:5432/bazarx?schema=public"

# --- Auth (Auth.js / NextAuth) -----------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-32-byte-secret

# --- Image storage service ---------------------------------------
# Leave the Cloudinary vars empty to use the built-in local-disk
# provider (writes to /public/uploads) — good enough for dev/demo.
# Set all three to switch ImageService over to CloudinaryImageProvider.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email service -------------------------------------------------
# Leave empty to use the ConsoleEmailProvider (logs emails to stdout).
# Provide SMTP settings to switch EmailService to SmtpEmailProvider.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="BazarX <no-reply@bazarx.demo>"

# --- Payments --------------------------------------------------------
# MockPaymentProvider is used automatically in development.
# These are placeholders for a future real Stripe integration (Tier 3).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Rate limiting -----------------------------------------------------
# Optional. If unset, an in-memory limiter is used (single-instance only).
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
